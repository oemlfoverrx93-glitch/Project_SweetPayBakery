# Copy to <CATALINA_BASE>/conf/sweetpay.properties.local.
# Obtain sandbox credentials from https://sandbox.vnpayment.vn/devreg/
# Never put merchant secrets in source control or in a JSP.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Set your public HTTPS base URL, including the deployed context path.
VNPAY_RETURN_URL=https://your-test-host.example/SweetBakery/payments/vnpay/return
# Register this IPN URL with VNPAY (not an application property):
# https://your-test-host.example/SweetBakery/payments/vnpay/ipn
